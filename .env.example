# Copy to .env.local for local dev. Set the same names in Vercel → Project → Settings → Environment Variables.
# Placeholder names only. Never commit real values.

# --- Database (Neon) ---
DATABASE_URL=
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_DATA_API_URL=

# --- LLM: Google Gemini (model IDs confirmed before use; read from env, never hardcoded) ---
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP=
GEMINI_MODEL_FAST=
GEMINI_MODEL_SMART=

# --- Vaani AI Research (docs.vaanivoice.ai) ---
VAANI_API_KEY=
VAANI_AGENT_ID=
# Webhook auth: HMAC secret if Vaani gives one (X-Vaani-Signature), else a URL token (?token=...)
VAANI_WEBHOOK_SECRET=
VAANI_WEBHOOK_TOKEN=

# --- Calendly (Phase 4) ---
CALENDLY_TOKEN=
CALENDLY_WEBHOOK_SIGNING_KEY=

# --- Telegram (Phase 5) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_NIKHIL_CHAT_ID=
TELEGRAM_OPS_CHAT_ID=

# --- Email (Resend: https://resend.com) ---
RESEND_API_KEY=
# e.g. "Aangan Studio <desk@yourdomain.in>". Needs a domain verified in Resend; empty = Resend sandbox sender (owner-only delivery)
EMAIL_FROM=
NIKHIL_EMAIL=

# --- HubSpot (founder view). Service key with crm.objects.contacts/deals read+write ---
HUBSPOT_TOKEN=
HUBSPOT_PORTAL_ID=

# --- App ---
APP_BASE_URL=
DASHBOARD_PASSWORD=
CRON_SECRET=
