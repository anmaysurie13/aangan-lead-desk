{
    "name": "aangan-lead-desk",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:seed": "tsx src/db/seed.ts",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "knowledge": "tsx scripts/build-knowledge.ts",
        "predev": "npm run knowledge",
        "prebuild": "npm run knowledge && tsx scripts/vaani-sync.ts --if-production",
        "pretest": "npm run knowledge",
        "pretypecheck": "npm run knowledge",
        "score": "tsx scripts/score.ts",
        "evals": "tsx evals/run.ts",
        "fixtures": "tsx scripts/extract-fixtures.ts",
        "vaani:sync": "tsx scripts/vaani-sync.ts",
        "simulate": "tsx scripts/simulate-vaani-call.ts"
    },
    "dependencies": {
        "@google/genai": "^2.28.0",
        "@neondatabase/serverless": "^1.2.0",
        "drizzle-orm": "^0.45.4",
        "next": "15.5.27",
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3",
        "@tailwindcss/postcss": "^4",
        "@types/node": "^24.19.1",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "dotenv": "^18.0.6",
        "drizzle-kit": "^0.31.11",
        "eslint": "^9",
        "eslint-config-next": "15.5.27",
        "pdf-parse": "^1.1.1",
        "tailwindcss": "^4",
        "tsx": "^4.23.15",
        "typescript": "^5",
        "vitest": "^5.0.3"
    }
}
